<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    core:require="{ formatter: 'net/bansemir/profile/model/formatter' }">

    <Table
        id="skillsTable"
        items="{skillsFlat>/}"
        growing="true"
        growingThreshold="20">
        <headerToolbar>
            <OverflowToolbar>
                <Title text="{i18n>skills.heading}" />
                <ToolbarSpacer />
                <SearchField width="15rem" search=".onSkillSearch" liveChange=".onSkillSearch" />
            </OverflowToolbar>
        </headerToolbar>
        <columns>
            <Column>
                <Text text="{i18n>skills.skill}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true">
                <Text text="{i18n>skills.category}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End">
                <Text text="{i18n>skills.experience}" />
            </Column>
            <Column minScreenWidth="Phone" demandPopin="true">
                <Text text="{i18n>skills.level}" />
            </Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <Text text="{skillsFlat>name}" />
                    <Text text="{skillsFlat>category}" />
                    <ObjectNumber
                        number="{skillsFlat>years}"
                        unit="{i18n>skills.years}" />
                    <ObjectStatus
                        text="{= ${skillsFlat>level} === 'expert' ? ${i18n>skills.level.expert} : (${skillsFlat>level} === 'advanced' ? ${i18n>skills.level.advanced} : ${i18n>skills.level.intermediate})}"
                        state="{path: 'skillsFlat>level', formatter: 'formatter.formatLevelState'}" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>
