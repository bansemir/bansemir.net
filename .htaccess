# bansemir.net — Apache configuration (IONOS shared hosting)
#
# Security headers + root redirect. The Content-Security-Policy is intentionally
# strict: scripts/styles/fonts come only from 'self' and the SAPUI5 CDN
# (ui5.sap.com), analytics from Plausible (plausible.io). Calendly is opened as a
# normal link in a new tab and is never framed, so it is deliberately NOT listed
# in frame-src. UI5 injects styles at runtime, so style-src needs 'unsafe-inline'.

# --- HTTPS enforcement -----------------------------------------------------------
# The 301s below would otherwise keep first-time HTTP visitors on plain HTTP
# (HSTS only protects returning visitors).
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- 301 redirect bare root to the German landing page --------------------------
RewriteRule ^$ /de/ [R=301,L]

# --- Security headers -----------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://ui5.sap.com https://plausible.io; style-src 'self' 'unsafe-inline' https://ui5.sap.com; font-src 'self' https://ui5.sap.com; img-src 'self' data:; connect-src 'self' https://ui5.sap.com https://plausible.io; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000"

    # --- Caching ----------------------------------------------------------------
    # HTML must always revalidate (ETag makes this cheap). Without an explicit
    # Cache-Control, browsers apply heuristic freshness based on Last-Modified
    # and can serve week-old pages after a deployment.
    <FilesMatch "\.html$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>
    # Images, fonts and the toolkit demo clips change rarely — cache for a day.
    <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico|woff2?|mp4)$">
        Header always set Cache-Control "public, max-age=86400"
    </FilesMatch>
    # Code and data: short cache so deployments propagate within minutes.
    <FilesMatch "\.(js|css|json|properties|xml)$">
        Header always set Cache-Control "public, max-age=300"
    </FilesMatch>
</IfModule>

# --- MIME types ------------------------------------------------------------------
# nosniff is set above, so a wrong or missing Content-Type stops the demo clips
# from playing rather than being silently corrected by the browser.
<IfModule mod_mime.c>
    AddType text/plain .properties
    AddType video/mp4 .mp4
</IfModule>
